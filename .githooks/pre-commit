#!/bin/sh
# Git pre-commit hook wrapper that invokes the PowerShell formatter script
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/pre-commit.ps1"
elif command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/pre-commit.ps1"
else
    exit 0
fi